# ==========================================
# Copia de seguridad del .env ANTERIOR a RabbitMQ
#
# Solo se conservan los NOMBRES de las variables, sin valores: este archivo
# queda como referencia de qué configuración existía antes de añadir el broker.
# Los valores reales viven únicamente en .env, que está en .gitignore.
#
# Si necesitas la lista completa y actualizada (RabbitMQ incluido), usa
# env.template en lugar de este archivo.
# ==========================================

# ------------------------------------------
# Configuración de PostgreSQL (Pacientes)
# ------------------------------------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# ------------------------------------------
# Configuración de MongoDB (Historial Médico)
# ------------------------------------------
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=
MONGO_PORT=

# ------------------------------------------
# Configuración de MySQL (Usuarios)
# ------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_PORT=

# ------------------------------------------
# Configuración de Keycloak (Seguridad)
# ------------------------------------------
KC_DB=
KC_ADMIN=
KC_ADMIN_PASSWORD=
KC_PORT=

# ------------------------------------------
# Puertos de los Microservicios
# ------------------------------------------
EUREKA_PORT=
GATEWAY_PORT=
PACIENTES_PORT=
HISTORIAL_PORT=
PACIENTES_FASTAPI_PORT=
