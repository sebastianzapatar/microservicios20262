# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Gradle
.gradle/
build/
# OJO: el patrón lleva "**/" a propósito. Sin él, la negación queda anclada a
# la raíz del repositorio y NO cubre los wrappers de cada microservicio
# (eureka-server/gradle/wrapper/...), que entonces *.jar se traga en silencio
# y las imágenes Docker fallan con "Unable to access jarfile".
!**/gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Python / uv
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
# uv.lock SÍ se versiona: fija las versiones exactas para toda la clase

# Salida de compilación de Maven / Eclipse (el proyecto usa Gradle, pero los
# IDEs generan estas carpetas igual). No deben versionarse.
target/
bin/
out/

# IDEs
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Environment variables
.env
.env.local

# OS generated files
.firecrawl/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
