# ==========================================
# Plantilla de Variables de Entorno
# Instrucciones:
# 1. Copia o renombra este archivo como ".env"
# 2. Llena los valores vacíos con tu configuración
# ==========================================

# ------------------------------------------
# Configuración de PostgreSQL (Pacientes)
# ------------------------------------------
POSTGRES_DB=pacientes_db
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ------------------------------------------
# Configuración de MongoDB (Historial Médico)
# ------------------------------------------
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=historial_medico_db
MONGO_PORT=27017

# ------------------------------------------
# Configuración de MySQL (Usuarios)
# ------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=usuarios_db
MYSQL_PORT=3306

# ------------------------------------------
# Configuración de Kafka (Eventos entre microservicios)
# ------------------------------------------
# Puerto por el que TU MÁQUINA se conecta al broker (los microservicios usan
# el listener interno 9092 dentro de la red de Docker, no este).
KAFKA_EXTERNAL_PORT=9094
# Consola web para ver topics, particiones y el lag de cada consumer group:
# http://localhost:8091
KAFKA_UI_PORT=8091

# ------------------------------------------
# Configuración de Keycloak (Seguridad)
# ------------------------------------------
KC_DB=dev-mem
KC_ADMIN=
KC_ADMIN_PASSWORD=
KC_PORT=8080

# ------------------------------------------
# Puertos de los Microservicios
# ------------------------------------------
EUREKA_PORT=8761
GATEWAY_PORT=8090
PACIENTES_PORT=8081
HISTORIAL_PORT=8082
PACIENTES_FASTAPI_PORT=8083
