# ==========================================
# Plantilla de Variables de Entorno
# Instrucciones:
# 1. Copia o renombra este archivo como ".env"
# 2. Llena los valores vacíos con tu configuración
# ==========================================

# ------------------------------------------
# Configuración de PostgreSQL (Pacientes)
# ------------------------------------------
POSTGRES_DB=pacientes_db
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ------------------------------------------
# Configuración de MongoDB (Historial Médico)
# ------------------------------------------
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=historial_medico_db
MONGO_PORT=27017

# ------------------------------------------
# Configuración de MySQL (Usuarios)
# ------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=usuarios_db
MYSQL_PORT=3306

# ------------------------------------------
# Configuración de RabbitMQ (Mensajería entre microservicios)
# ------------------------------------------
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# Puerto del protocolo AMQP, el que usan los microservicios.
RABBITMQ_PORT=5672
# Puerto de la consola web: http://localhost:15672 (entra con el usuario de arriba).
RABBITMQ_MGMT_PORT=15672

# ------------------------------------------
# Configuración de Keycloak (Seguridad)
# ------------------------------------------
KC_DB=dev-mem
KC_ADMIN=
KC_ADMIN_PASSWORD=
KC_PORT=8080

# ------------------------------------------
# Puertos de los Microservicios
# ------------------------------------------
EUREKA_PORT=8761
GATEWAY_PORT=8090
PACIENTES_PORT=8081
HISTORIAL_PORT=8082
PACIENTES_FASTAPI_PORT=8083
